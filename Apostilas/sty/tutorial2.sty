\newcommand{\codigo}[1]{{\ttfamily #1}}
\newcommand{\aspas}[1]{"#1"}

%-----------------------------------------------------------------------------
% Bloco ATENÇÃO (mdframed)
%-----------------------------------------------------------------------------
\newenvironment{theo}[2][]{%
	\ifstrempty{#1}%
	{\mdfsetup{%
			frametitle={%
				\tikz[baseline=(current bounding box.east),outer sep=0pt]%
				\node[anchor=east,rectangle,fill=red!20]%
				{\strut ATENÇÃO};}%
		}%
	}{\mdfsetup{%
			frametitle={%
				\tikz[baseline=(current bounding box.east),outer sep=0pt]%
				\node[anchor=east,rectangle,fill=red!20]%
				{\strut ATENÇÃO:~#1};}%
		}%
	}%
	\mdfsetup{%
		innertopmargin=10pt,linecolor=red!20,%
		linewidth=2pt,topline=true,%
		frametitleaboveskip=\dimexpr-\ht\strutbox\relax%
	}%
	\begin{mdframed}[]\relax}{%
	\end{mdframed} \vspace{-3mm}
}

%-----------------------------------------------------------------------------
% Bloco PROMPT (verbatim com quebra automática, incluindo quebra em qualquer caractere)
%-----------------------------------------------------------------------------
% Comando para imprimir o título acima do prompt
\newcommand{\prompttitle}[1]{%
	\par\vspace{0.4em}%
	\noindent{\sffamily\bfseries\small\color{primary}#1\par}%
	\vspace{0.2em}%
}

% Ambiente listings (sem \par, sem \noindent no argumento)
\lstnewenvironment{promptbox}[1][]{%
	\prompttitle{#1}%
	\lstset{%
		basicstyle=\ttfamily\small,
		breaklines=true,
		breakatwhitespace=false,
		columns=flexible,
		keepspaces=true,
		showstringspaces=false,
		numbers=none,
		xleftmargin=0pt,
		xrightmargin=0pt,
		aboveskip=0pt,
		belowskip=0.4em,
		literate=%
		{á}{{\'a}}1 {à}{{\`a}}1 {ã}{{\~a}}1 {â}{{\^a}}1
		{é}{{\'e}}1 {ê}{{\^e}}1 {í}{{\'i}}1
		{ó}{{\'o}}1 {õ}{{\~o}}1 {ô}{{\^o}}1
		{ú}{{\'u}}1 {ç}{{\c c}}1
		{Á}{{\'A}}1 {À}{{\`A}}1 {Ã}{{\~A}}1 {Â}{{\^A}}1
		{É}{{\'E}}1 {Ê}{{\^E}}1 {Í}{{\'I}}1
		{Ó}{{\'O}}1 {Õ}{{\~O}}1 {Ô}{{\^O}}1
		{Ú}{{\'U}}1 {Ç}{{\c C}}1,%
	}%
}{%
	\vspace{0.2em}%
}
